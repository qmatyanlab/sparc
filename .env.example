# Copy to .env (git-ignored) and fill in as needed.

# HuggingFace token for downloading the asset repo (or run: huggingface-cli login).
# Required only while AngusHsuPhys/sparc-assets is private and your account has access.
# HF_TOKEN=hf_xxx

# Weights & Biases is opt-in (the default logger is csv). Uncomment to use it.
# WANDB_API_KEY=xxx
# WANDB_MODE=offline

# Override the asset repo / type if you mirror the assets elsewhere.
# SPARC_HF_REPO=AngusHsuPhys/sparc-assets
# SPARC_HF_REPO_TYPE=model

# On air-gapped compute nodes (assets pre-fetched on a login node): SPARC_SKIP_ASSET_DOWNLOAD=1

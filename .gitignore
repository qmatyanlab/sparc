# Python / build
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.eggs/

# Environments & tool caches
.venv/
.uv_cache/
.ruff_cache/
.cache/
.env

# HuggingFace local cache created by local_dir downloads
**/.cache/huggingface/

# Run outputs (regenerated by running main.py; wandb/hydra logs live under exp_res/)
exp_res/
runtime/
wandb/
*.log

# OS / editor cruft
.DS_Store
._*

# Large assets — auto-downloaded from HuggingFace on first run (see utils/assets.py).
# Path-specific (NOT extension wildcards) so source/config/data files are still tracked.
data/mp_20/*.pt
data/mp_20/*.csv
data/dielectric/*.torch
data/dielectric/cached_*.pt
data/symmcd_pretrained/
data/surrogates/*.torch
rewards/calculators/tsenn/*.torch
rewards/calculators/syn_score/model_pt/
rewards/tsenn_cache/

# Intentionally tracked (small, needed at runtime): configs/**, *.yaml, data/onehot/**,
# data/dielectric/utils/**, data/dielectric/*.yaml, rewards/calculators/tsenn_slme/data/**

# Offline HF cache staged locally; junk sidecar file
.hf_cache/
dataset_data_range

# active_learning subproject: track the CODE, ignore its data/artifacts blobs
active_learning/artifacts/
active_learning/data/
active_learning/**/__pycache__/


figure4_cifs.tar.gz